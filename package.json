{
  "name": "autonomous-development-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first autonomous development orchestrator coordinating project reasoning brain and coding agent",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=packages/shared-types",
    "build:apps": "npm run build --workspace=apps/server && npm run build --workspace=apps/web",
    "build": "npm run build:packages && npm run build:apps",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "npm run build:packages && tsx apps/server/src/server.ts",
    "start": "npm run build && node apps/server/dist/server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "playwright": "^1.50.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
