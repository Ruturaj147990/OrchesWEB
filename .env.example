# ==============================================================================
# Orches - Autonomous Development Orchestrator
# Configuration Template (.env.example)
#
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server network binding (loopback-only recommended for security)
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4317

# Application environment ('production' or 'development')
NODE_ENV=production

# Data directory for persistent SQLite database and runtime metadata.
# If left blank, defaults to standard platform paths:
#   Windows: %APPDATA%\AutonomousDevOrchestrator
#   Linux:   ~/.config/AutonomousDevOrchestrator
#   macOS:   ~/Library/Application Support/AutonomousDevOrchestrator
# ORCHESTRATOR_DATA_DIR=

# Allowed HTTP CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4317,http://127.0.0.1:4317

# ChatGPT Web Provider Settings
# Set to 'true' to run Chromium headlessly (requires prior authentication)
CHATGPT_WEB_HEADLESS=false

# Directory for ChatGPT Web persistent browser session profile.
# Defaults to: <ORCHESTRATOR_DATA_DIR>/browser/chatgpt
# CHATGPT_WEB_PROFILE_DIR=

# Maximum wait timeout for reasoning model responses in milliseconds (default: 300000 = 5 minutes)
CHATGPT_WEB_TIMEOUT_MS=300000
