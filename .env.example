# Orches — optional environment configuration. Copy to .env (never commit real keys).
# Everything here can also be changed in the dashboard's Settings dialog.

# Server (binds to loopback only by default)
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4317

# Where the database, settings and workspace snapshots live.
# Default: %APPDATA%\AutonomousDevOrchestrator (Windows) or ~/.config/AutonomousDevOrchestrator
ORCHESTRATOR_DATA_DIR=

# Local reasoning (Ollama or any OpenAI-compatible server) — defaults for first launch
LOCAL_REASONING_BASE_URL=http://127.0.0.1:11434
LOCAL_REASONING_MODEL=llama3.1:8b

# OpenAI API key (only needed if you select OpenAI in Settings)
OPENAI_API_KEY=

# Extra browser origins allowed to call the API (loopback origins are always allowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
