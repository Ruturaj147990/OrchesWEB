# Autonomous Development Orchestrator — Environment Configuration
# Copy this file to .env for local configuration.
# Never commit real API keys or credentials to version control.

# Server Configuration
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4317
NODE_ENV=development

# Storage & Data Paths (Defaults to OS user application data directory)
# Leave blank to use default OS directory: %APPDATA%/AutonomousDevOrchestrator
ORCHESTRATOR_DATA_DIR=

# Reasoning Providers (Cloud & Local)
# OpenAI API key (Only required if using OpenAI Cloud reasoning)
OPENAI_API_KEY=

# Local Model Endpoint (e.g., Ollama, llama.cpp, vLLM)
LOCAL_REASONING_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_REASONING_MODEL=llama3.1:8b

# Coding Agent Settings
# Path to Antigravity CLI executable if not in system PATH
AGY_CLI_PATH=

# Security & CORS
# Allowed web origins for loopback API access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4317,http://127.0.0.1:4317
